{
  "name": "send-it",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "gen:dirtline": "tsx scripts/gen-dirtline.ts",
    "ride:dirtline": "tsx scripts/ride-dirtline.ts",
    "gen:parks": "tsx scripts/gen-parks.ts",
    "sim:vert": "tsx scripts/sim-vert.ts",
    "ride:parks": "tsx scripts/ride-parks.ts",
    "server": "node server/index.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:aero": "tsx scripts/test-aero.ts",
    "sim:air": "tsx scripts/sim-air.ts",
    "trace:air": "tsx scripts/trace-air.ts",
    "test:all": "tsx scripts/test-aero.ts && tsx scripts/sim-air.ts && tsx scripts/sim.ts && tsx scripts/sim-vert.ts && tsx scripts/ride-parks.ts && tsx scripts/ride-dirtline.ts && node scripts/test-server.mjs"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
